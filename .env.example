# Required
ADMIN_API_KEY=changeme

# Gmail (optional, needed for email forwarding through the env-based Gmail provider)
GMAIL_SENDER_EMAIL=you@gmail.com

# CORS: comma-separated origins (empty = allow all)
# CORS_ORIGINS=https://yourdomain.com

# Event retention in days (default: 30)
# EVENT_RETENTION_DAYS=30

# SQLite database (default inside the container: sqlite:///data/hookforms.db)
# DATABASE_URL=sqlite://./hookforms.db

# POSTGRES_PASSWORD and REDIS_PASSWORD from older installs are accepted and ignored.
